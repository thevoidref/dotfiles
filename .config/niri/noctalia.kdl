layout {

    focus-ring {
        active-color   "#a4d577"
        inactive-color "#121410"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a4d577"
        inactive-color "#121410"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a4d577"
        inactive-color "#2a5000"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a4d57780"
    }
}

recent-windows {
    highlight {
        active-color "#a4d577"
        urgent-color "#ffb4ab"
    }
}
