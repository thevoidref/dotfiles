layout {

    focus-ring {
        active-color   "#91ba91"
        inactive-color "#1d2021"
        urgent-color   "#df6f63"
    }

    border {
        active-color   "#91ba91"
        inactive-color "#1d2021"
        urgent-color   "#df6f63"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#91ba91"
        inactive-color "#2f692f"
        urgent-color   "#df6f63"
    }

    insert-hint {
        color "#91ba9180"
    }
}

recent-windows {
    highlight {
        active-color "#91ba91"
        urgent-color "#df6f63"
    }
}
