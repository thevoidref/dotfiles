layout {

    focus-ring {
        active-color   "#4fd8eb"
        inactive-color "#101415"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#4fd8eb"
        inactive-color "#101415"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#4fd8eb"
        inactive-color "#004f58"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#4fd8eb80"
    }
}

recent-windows {
    highlight {
        active-color "#4fd8eb"
        urgent-color "#ffb4ab"
    }
}
