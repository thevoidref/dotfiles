layout {

    focus-ring {
        active-color   "#78aa78"
        inactive-color "#1d2021"
        urgent-color   "#df6f63"
    }

    border {
        active-color   "#78aa78"
        inactive-color "#1d2021"
        urgent-color   "#df6f63"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#78aa78"
        inactive-color "#234d23"
        urgent-color   "#df6f63"
    }

    insert-hint {
        color "#78aa7880"
    }
}

recent-windows {
    highlight {
        active-color "#78aa78"
        urgent-color "#df6f63"
    }
}
