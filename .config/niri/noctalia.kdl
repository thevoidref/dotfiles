layout {

    focus-ring {
        active-color   "#b9cda1"
        inactive-color "#131411"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b9cda1"
        inactive-color "#131411"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b9cda1"
        inactive-color "#233314"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b9cda180"
    }
}

recent-windows {
    highlight {
        active-color "#b9cda1"
        urgent-color "#ffb4ab"
    }
}
